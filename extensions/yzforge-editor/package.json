{
  "name": "yzforge-editor",
  "title": "YZForge 工作台",
  "version": "0.1.0",
  "package_version": 2,
  "description": "模块、资源包、UI 自动绑定和配置表的统一工作台",
  "author": "YZForge",
  "main": "main.js",
  "panels": {
    "default": {
      "title": "YZForge 工作台",
      "type": "dockable",
      "main": "panel.js",
      "size": {
        "width": 1100,
        "height": 810,
        "min-width": 600,
        "min-height": 480
      }
    }
  },
  "contributions": {
    "menu": [
      {
        "path": "YZForge",
        "label": "项目工作台",
        "message": "open-panel"
      },
      {
        "path": "YZForge/游戏设置",
        "label": "打开渠道参数 JSON",
        "message": "open-game-config"
      },
      {
        "path": "YZForge/游戏设置",
        "label": "导出构建参数",
        "message": "export-game-build"
      },
      {
        "path": "YZForge/游戏设置",
        "label": "恢复中断的构建",
        "message": "recover-game-build"
      }
    ],
    "messages": {
      "recover-game-build": {
        "methods": [
          "recoverGameBuild"
        ]
      },
      "game-settings-state": {
        "methods": [
          "gameSettingsState"
        ]
      },
      "open-panel": {
        "methods": [
          "openPanel"
        ]
      },
      "dispatch": {
        "methods": [
          "dispatch"
        ]
      },
      "state": {
        "methods": [
          "state"
        ]
      },
      "open-game-config": {
        "methods": [
          "openGameConfig"
        ]
      },
      "export-game-build": {
        "methods": [
          "exportGameBuild"
        ]
      }
    },
    "scene": {
      "script": "scene.js"
    },
    "builder": "builder.js",
    "preview": {
      "*": {
        "methods": "./game-preview.js",
        "hooks": {
          "settings": "checkSettings"
        }
      }
    }
  }
}
