{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "YZForge: 完整检查",
      "type": "npm",
      "script": "verify",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "YZForge: ESLint 检查",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "YZForge: ESLint 自动修复",
      "type": "npm",
      "script": "lint:fix",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "YZForge: 格式化",
      "type": "npm",
      "script": "format",
      "problemMatcher": []
    },
    {
      "label": "YZForge: TypeScript 检查",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "YZForge: 生成资源目录与配置",
      "type": "npm",
      "script": "generate",
      "problemMatcher": []
    },
    {
      "label": "YZForge: 自动化测试",
      "type": "npm",
      "script": "test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
