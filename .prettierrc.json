{
  "$schema": "https://json.schemastore.org/prettierrc",
  "tabWidth": 4,
  "useTabs": false,
  "printWidth": 120,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "bracketSpacing": true,
  "embeddedLanguageFormatting": "off",
  "overrides": [
    {
      "files": ["*.json", "*.jsonc", "*.md", "*.yml", "*.yaml"],
      "options": { "tabWidth": 2, "proseWrap": "preserve" }
    }
  ]
}
