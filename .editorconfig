root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,md,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Cocos serialization is edited through Creator, not normalized by the editor.
[*.{meta,prefab,scene}]
insert_final_newline = unset
trim_trailing_whitespace = unset
end_of_line = unset
